#include <behaviors.dtsi>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/input/suppress.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen { zmk,physical-layout = &test_layout; };
    test_transform: test_transform {
        compatible = "zmk,matrix-transform";
        rows = <2>; columns = <2>;
        map = <RC(0,0) RC(0,1) RC(1,0) RC(1,1)>;
    };
    test_layout: test_layout {
        compatible = "zmk,physical-layout";
        display-name = "Touch test";
        transform = <&test_transform>;
        keys = <&key_physical_attrs 100 100 0 0 0 0 0>,
               <&key_physical_attrs 100 100 100 0 0 0 0>,
               <&key_physical_attrs 100 100 0 100 0 0 0>,
               <&key_physical_attrs 100 100 100 100 0 0 0>;
    };
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <&kp A &kp B &kp C &kp D>;
        };

        /* Selects the pad listener's layer route. */
        route {
            bindings = <&trans &trans &trans &trans>;
        };

        /* What an edge contact holds; selects the final mask. */
        target {
            bindings = <&trans &trans &trans &trans>;
        };
    };

    /* A strip decided on X, whose coordinate carries no sync. */
    right_strip: right_strip {
        compatible = "zmk,input-processor-temp-layer-touch";
        #input-processor-cells = <0>;
        layer = <2>;
        width = <50>;
        edge = "right";
    };

    /* A strip decided on Y, the coordinate that carries a report's sync. */
    bottom_strip: bottom_strip {
        compatible = "zmk,input-processor-temp-layer-touch";
        #input-processor-cells = <0>;
        layer = <2>;
        width = <50>;
        edge = "bottom";
    };

    final_filter: final_filter {
        compatible = "zmk,input-processor-suppress";
        #input-processor-cells = <1>;
    };

    /* Sends nothing by itself; the self-tests report through it. */
    pad: pad {
        compatible = "zmk,input-mock";
        event-period = <100>;
        events = <>;
    };

    pad_listener {
        compatible = "zmk,input-listener";
        device = <&pad>;
        input-processors = <&right_strip>, <&final_filter SUPPRESS_TOUCH>;

        edge_scroll {
            layers = <2>;
            input-processors = <&right_strip>, <&final_filter (SUPPRESS_TOUCH | SUPPRESS_BUTTONS)>;
        };

        layer_route {
            layers = <1>;
            input-processors = <&right_strip>, <&final_filter SUPPRESS_TOUCH>;
        };
    };

    /* A second listener, so the processors have at least two streams. */
    idle_source: idle_source {
        compatible = "zmk,input-mock";
        event-period = <100>;
        events = <>;
    };

    idle_listener {
        compatible = "zmk,input-listener";
        device = <&idle_source>;
        input-processors = <&right_strip>, <&bottom_strip>, <&final_filter SUPPRESS_TOUCH>;
        edge_scroll {
            layers = <2>;
            input-processors = <&right_strip>, <&bottom_strip>, <&final_filter (SUPPRESS_TOUCH | SUPPRESS_BUTTONS)>;
        };
    };
};

/* An empty mock exits at boot; one late press keeps the process up for the tests. */
&kscan {
    events = <ZMK_MOCK_PRESS(0,0,30000)>;
};
